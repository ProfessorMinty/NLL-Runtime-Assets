{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northernlightslabs.example/schemas/manifest-index.schema.json",
  "title": "Northern Lights Runtime Manifest Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generator",
    "generatedAt",
    "manifests"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets", "collections", "themes"],
      "properties": {
        "assets": { "type": "string", "minLength": 1 },
        "collections": { "type": "string", "minLength": 1 },
        "themes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
