{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ProfessorMinty/NLL-Runtime-Assets/main/schemas/asset-registry.schema.json",
  "title": "Northern Lights Runtime Asset Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generator",
    "generatedAt",
    "assetCount",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "assetCount": {
      "type": "integer",
      "minimum": 0
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "status",
        "accessibility",
        "rights",
        "variants"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "subtype": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated"]
        },
        "tags": { "$ref": "#/$defs/stringList" },
        "themes": { "$ref": "#/$defs/stringList" },
        "subjects": { "$ref": "#/$defs/stringList" },
        "useCases": { "$ref": "#/$defs/stringList" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "rights": { "$ref": "#/$defs/rights" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["decorative", "informative"]
        },
        "alt": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "informative" } },
            "required": ["role"]
          },
          "then": {
            "required": ["alt"],
            "properties": {
              "alt": { "minLength": 1 }
            }
          }
        }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["approved-runtime-use", "credit-required"]
        },
        "credit": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "credit-required" } },
            "required": ["status"]
          },
          "then": { "required": ["credit"] }
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "mimeType",
        "bytes",
        "sha256"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^assets/"
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "height": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    }
  }
}
