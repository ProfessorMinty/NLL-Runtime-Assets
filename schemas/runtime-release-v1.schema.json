{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ProfessorMinty/NLL-Runtime-Assets/main/schemas/runtime-release-v1.schema.json",
  "title": "Northern Lights Runtime Release V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "predecessorReleaseId",
    "consumerCatalog",
    "objects",
    "candidateIdentity",
    "publisherIdentity",
    "publicationAuthorizationIdentity",
    "transactionRecoveryAuthorizationIdentity",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "$ref": "#/$defs/releaseId" },
    "predecessorReleaseId": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/releaseId" }
      ]
    },
    "consumerCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "path", "sha256"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^manifests/releases/runtime-v1-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*/consumer-catalog\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 0,
      "maxItems": 65000,
      "items": { "$ref": "#/$defs/runtimeObject" }
    },
    "candidateIdentity": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "publisherIdentity": { "const": "NL Asset Runtime Publisher" },
    "publicationAuthorizationIdentity": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "transactionRecoveryAuthorizationIdentity": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "releaseId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^runtime-v1-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectKey", "url", "sha256", "bytes"],
      "properties": {
        "objectKey": {
          "type": "string",
          "pattern": "^objects/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://cdn\\.nlightlabs\\.com/objects/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 }
      }
    }
  }
}
